# Python bytecode (skills ship .py sources; compiled artifacts are regenerated)
__pycache__/
*.py[cod]

# Node dependencies (skills declare deps; installs are local, not committed)
node_modules/

# OS / editor cruft
.DS_Store

# Build artifacts (Desktop skill zips, etc.)
/dist/

# npm install inside a skill dir leaves these behind (skills declare deps in SKILL.md;
# no package.json is tracked anywhere in this repo)
plugins/*/skills/*/package.json
plugins/*/skills/*/package-lock.json
